<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_keyboard"
                android:contentDescription="DigitBoard Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DigitBoard v1.0.0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/neu_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teclado Neumorphism com CI/CD"
                    android:textSize="13sp"
                    android:textColor="@color/neu_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- IME Onboarding Steps -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Ativação do Teclado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neu_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_neumorphic_button"
                android:text="@string/enable_ime_step1"
                android:textColor="@color/neu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_select_ime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neumorphic_button"
                android:text="@string/select_ime_step2"
                android:textColor="@color/neu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Test Input Sandbox -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/test_ime_step3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neu_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorphic_inset"
            android:padding="12dp">

            <EditText
                android:id="@+id/edit_test_input"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="Toque aqui para testar o teclado DigitBoard..."
                android:textColor="@color/neu_text_primary"
                android:textColorHint="@color/neu_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Theme Selection Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Seleção de Tema"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neu_text_primary" />

        <RadioGroup
            android:id="@+id/rg_themes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorphic_card"
            android:padding="16dp">

            <RadioButton
                android:id="@+id/rb_theme_neu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="@string/theme_neumorphism"
                android:textColor="@color/neu_text_primary" />

            <RadioButton
                android:id="@+id/rb_theme_amoled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/theme_amoled"
                android:textColor="@color/neu_text_primary" />

            <RadioButton
                android:id="@+id/rb_theme_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/theme_light"
                android:textColor="@color/neu_text_primary" />

            <RadioButton
                android:id="@+id/rb_theme_rgb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/theme_rgb"
                android:textColor="@color/neu_text_primary" />
        </RadioGroup>

        <!-- Features Toggles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Preferências"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/neu_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorphic_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_haptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="@string/pref_haptic"
                android:textColor="@color/neu_text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="@string/pref_sound"
                android:textColor="@color/neu_text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_number_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="@string/pref_number_row"
                android:textColor="@color/neu_text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="@string/pref_suggestions"
                android:textColor="@color/neu_text_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
